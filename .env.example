# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=deepker
SSL_MODE=disable
TIME_ZONE=UTC

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_password
REDIS_DB=0
REDIS_ENABLED=true

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=5m

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=debug

# JWT Configuration
JWT_SECRET_KEY=mySecretKey
JWT_EXPIRES_IN=24h

# CORS Configuration
ALLOWED_ORIGIN=http://localhost:3000

# Example settings for different environments:

# Development settings (default values shown above)
# CACHE_ENABLED=true
# REDIS_ENABLED=true
# GIN_MODE=debug

# Production settings
# CACHE_ENABLED=true
# REDIS_ENABLED=true
# GIN_MODE=release
# JWT_EXPIRES_IN=1h

# Testing/CI settings (disable cache for testing)
# CACHE_ENABLED=false
# REDIS_ENABLED=false
# GIN_MODE=test

# Local development without Redis
# CACHE_ENABLED=false
# REDIS_ENABLED=false